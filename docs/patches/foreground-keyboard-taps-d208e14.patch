+const KEYBOARD_BUTTONS: [(i32, u32); 10] = [(0x0D, A), (0x20, A), (0x1B, B), (0x08, B), (0x26, DPAD_UP), (0x28, DPAD_DOWN), (0x25, DPAD_LEFT), (0x27, DPAD_RIGHT), (0x09, VIEW), (0x50, MENU)];
+const TAP_DURATION: Duration = Duration::from_millis(125);
+
+struct KeyboardTaps {
+    until: [Option<Instant>; u32::BITS as usize],
+}
+
+impl KeyboardTaps {
+    const fn new() -> Self {
+        Self { until: [None; u32::BITS as usize] }
+    }
+
+    fn remember(&mut self, button: u32, now: Instant) {
+        self.until[button.trailing_zeros() as usize] = Some(now + TAP_DURATION);
+    }
+
+    fn buttons(&mut self, now: Instant, focused: bool) -> u32 {
+        if !focused {
+            self.until.fill(None);
+            return 0;
+        }
+        self.until.iter().enumerate().fold(0, |buttons, (bit, expires)| {
+            if expires.is_some_and(|until| now < until) { buttons | (1 << bit) } else { buttons }
+        })
+    }
+}
+
+static KEYBOARD_TAPS: Mutex<KeyboardTaps> = Mutex::new(KeyboardTaps::new());
+static TRACE_RECEIPTS: AtomicU32 = AtomicU32::new(0);
+
+fn keyboard_tap_options() -> (bool, bool) {
+    static OPTIONS: OnceLock<(bool, bool)> = OnceLock::new();
+    *OPTIONS.get_or_init(|| {
+        let enabled = |name| std::env::var_os(name).as_deref() == Some(std::ffi::OsStr::new("1"));
+        (enabled("XCL_KEYBOARD_TAPS"), enabled("XCL_TRACE_KEYBOARD_TAPS"))
+    })
+}
+
+pub(crate) fn keyboard_tap_messages_enabled() -> bool {
+    let (enabled, trace) = keyboard_tap_options();
+    enabled || trace
+}
+
+fn keyboard_tap_button(key: i32, previous_down: bool) -> Option<u32> {
+    if previous_down {
+        return None;
+    }
+    KEYBOARD_BUTTONS.iter().find(|&&(vk, _)| vk == key).map(|&(_, button)| button)
+}
+
+/// An initial mapped keydown delivered to the owned presenter (not system-key messages).
+pub(crate) fn note_keyboard_tap(key: i32, previous_down: bool, focused: bool) {
+    let Some(button) = keyboard_tap_button(key, previous_down) else { return };
+    let (enabled, trace) = keyboard_tap_options();
+    let latched = enabled && focused;
+    if latched {
+        KEYBOARD_TAPS.lock().unwrap_or_else(|e| e.into_inner()).remember(button, Instant::now());
+    }
+    static LOGGED: AtomicU32 = AtomicU32::new(0);
+    if trace && LOGGED.fetch_add(1, Ordering::Relaxed) < 16 {
+        TRACE_RECEIPTS.fetch_or(button, Ordering::Relaxed);
+        crate::xlog_info!("GameInput keyboard: owned WM_KEYDOWN vk={key:#x} button={button:#x} focus={focused} latched={latched}");
+    }
+}
+
+pub(crate) fn clear_keyboard_taps() {
+    if keyboard_tap_options().0 {
+        KEYBOARD_TAPS.lock().unwrap_or_else(|e| e.into_inner()).until.fill(None);
+    }
+}
+
+fn trace_keyboard_poll(foreground: u32, held: u32, latched: u32) {
+    static LAST_FOCUS: AtomicU32 = AtomicU32::new(u32::MAX);
+    static FOCUS_LOGGED: AtomicU32 = AtomicU32::new(0);
+    if LAST_FOCUS.swap(foreground, Ordering::Relaxed) != foreground && FOCUS_LOGGED.fetch_add(1, Ordering::Relaxed) < 12 {
+        crate::xlog_info!("GameInput keyboard: foreground presenter={} own process={}", foreground == 2, foreground != 0);
+    }
+    static LAST_BUTTONS: AtomicU64 = AtomicU64::new(0);
+    static SAMPLE_LOGGED: AtomicU32 = AtomicU32::new(0);
+    let sample = (u64::from(held) << 32) | u64::from(latched);
+    let last = LAST_BUTTONS.swap(sample, Ordering::Relaxed);
+    let received = TRACE_RECEIPTS.swap(0, Ordering::Relaxed);
+    if (received != 0 || last != sample) && SAMPLE_LOGGED.fetch_add(1, Ordering::Relaxed) < 32 {
+        crate::xlog_info!("GameInput keyboard: poll received={received:#x} held={held:#x} latched={latched:#x}");
+    }
+}
